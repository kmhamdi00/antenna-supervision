<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Supervision Antennes</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container py-4">
    <h1 class="h3 mb-4">Supervision du réseau d'antennes</h1>

    <form id="filters" class="row g-2 mb-4">
        <div class="col-auto">
            <input type="text" class="form-control" id="filter-city" placeholder="Ville">
        </div>
        <div class="col-auto">
            <select class="form-select" id="filter-status">
                <option value="">Tous les statuts</option>
                <option value="UP">UP</option>
                <option value="DOWN">DOWN</option>
            </select>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Filtrer</button>
        </div>
    </form>

    <div id="alert-zone"></div>

    <table class="table table-striped table-hover bg-white align-middle">
        <thead>
        <tr>
            <th>#</th>
            <th>Nom</th>
            <th>Ville</th>
            <th>Statut</th>
            <th>Dernière intervention</th>
            <th></th>
        </tr>
        </thead>
        <tbody id="antennas-body">
            <tr><td colspan="6" class="text-center text-muted">Chargement...</td></tr>
        </tbody>
    </table>

    <nav>
        <ul class="pagination" id="pagination"></ul>
    </nav>
</div>

<script>
    window.__API_KEY__ = {{ api_key|json_encode|raw }};
</script>
<script src="/js/dashboard.js"></script>
</body>
</html>